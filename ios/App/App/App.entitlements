<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (Xcode switches this to "production" when you archive for the App Store). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: joinliftd.com/app/… links open the app (needs public/.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:joinliftd.com</string>
	</array>
</dict>
</plist>
